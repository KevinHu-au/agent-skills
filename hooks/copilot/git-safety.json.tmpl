{
  "version": 1,
  "hooks": {
    "userPromptSubmitted": [
      {
        "type": "command",
        "bash": "\"@HOME@/.agents/hooks/block-dangerous-shell.sh\" --harness copilot --event prompt",
        "timeoutSec": 5
      }
    ],
    "preToolUse": [
      {
        "type": "command",
        "matcher": "bash|powershell|skill",
        "bash": "\"@HOME@/.agents/hooks/block-dangerous-shell.sh\" --harness copilot --event tool",
        "timeoutSec": 5
      }
    ]
  }
}
